# This build scores locally with the Laya typed-decisions checkpoint.
SCORING_PROVIDER=laya-local

# To use a custom local model adapter, provide all three values below.
# The module must export createEvaluator(config) and return the CandidateEvaluator contract.
# SCORING_PROVIDER=my-local-model
# SCORING_MODEL_ID=org/model-name@commit-or-revision
# SCORING_ADAPTER_MODULE=./adapters/my-local-model.mjs

# Optional Hugging Face token for model downloads. A saved `hf auth login` also works.
HF_TOKEN=
